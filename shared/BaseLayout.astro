---
// Shared <head> and page shell for all three sites.
interface Props {
  title: string;
  description: string;
  lang: 'en' | 'es';
  /** The same page in the other language, as a path ("/" or "/es/"). */
  altPath: string;
  /** Keep a page out of Google until the site launches. */
  noindex?: boolean;
}
const { title, description, lang, altPath, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altPath, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'en' ? 'es' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(lang === 'en' ? Astro.url.pathname : altPath, Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>
