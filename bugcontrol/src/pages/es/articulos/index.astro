---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../components/Layout.astro';
import { articleText } from '@guanacaste/shared/articles';
import { paths } from '@guanacaste/shared/contact';
import { site } from '../../../content';

const lang = 'es';
const other = 'en';
const t = articleText(lang, site);
const list = (await getCollection('articles', (a) => a.id.startsWith(`${lang}/`) && !a.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const slug = (id: string) => id.split('/').pop();
---
<Layout {lang} title={t.title} description={t.description} altPath={paths[other].articles}>
  <main class="articles">
    <h1>{t.h1}</h1>
    {list.length === 0 ? (
      <p class="articles-empty">{t.empty} <a href={`${paths[lang].home}#request-section`}>{t.emptyLink}</a></p>
    ) : (
      <ul class="article-list">
        {list.map((a) => (
          <li>
            <a class="article-card" href={`${paths[lang].articles}${slug(a.id)}/`}>
              <Image class="article-thumb" src={a.data.cover} alt={a.data.coverAlt} widths={[240, 480]} sizes="(min-width: 760px) 220px, 34vw" format="webp" />
              <span class="article-card-text">
                <h2>{a.data.title}</h2>
                <p>{a.data.description}</p>
                <time datetime={a.data.date.toISOString()}>{t.date(a.data.date)}</time>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
