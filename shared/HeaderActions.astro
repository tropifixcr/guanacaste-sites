---
// Header actions shared by the three sites: Articles, language switch, WhatsApp, and a jump to the request form.
// On phones, Articles and the language switch move to <SubNav> under the header. Each site styles these classes in its own world.
import { whatsappLink, paths, type Lang } from './contact';
interface Props { lang: Lang; waText: string; altPath: string; langLabel: string; hreflang: string }
const { lang, waText, altPath, langLabel, hreflang } = Astro.props;
const t = lang === 'en'
  ? { cta: 'Send a request', ctaShort: 'Request', articles: 'Articles' }
  : { cta: 'Enviar solicitud', ctaShort: 'Solicitar', articles: 'Artículos' };
---
<nav class="bar-actions" aria-label={lang === 'en' ? 'Main' : 'Principal'}>
  <a class="bar-articles bar-wide" href={paths[lang].articles}>{t.articles}</a>
  <a class="lang bar-wide" href={altPath} hreflang={hreflang} lang={hreflang}>{langLabel}</a>
  <a class="bar-wa" href={whatsappLink(waText)} target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3 1 2.5c.1.2 1.6 2.5 3.9 3.5 1.5.6 2 .7 2.8.6.4-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.4Z"/></svg>
    <span class="bar-long">WhatsApp</span>
  </a>
  <a class="bar-cta" href={`${paths[lang].home}#request-section`}>
    <span class="bar-long">{t.cta}</span><span class="bar-short">{t.ctaShort}</span>
  </a>
</nav>
