---
// Shared <head> and page shell for all three sites. Each site brings its own CSS and fonts.
interface Props {
  title: string;
  description: string;
  lang: 'en' | 'es';
  /** The same page in the other language, as a path ("/" or "/es/"). */
  altPath: string;
  siteName: string;
  themeColor: string;
  /** Keep a page out of Google until the site launches. */
  noindex?: boolean;
  jsonLd?: object[];
}
const { title, description, lang, altPath, siteName, themeColor, noindex = true, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altPath, Astro.site);
const en = lang === 'en' ? canonical : alternate;
const es = lang === 'es' ? canonical : alternate;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="x-default" href={en} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CR'} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
