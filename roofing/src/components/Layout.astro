---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-semi-condensed/600.css';
import '@fontsource/barlow-semi-condensed/700.css';
import '../styles/site.css';
import BaseLayout from '@guanacaste/shared/BaseLayout.astro';
import { paths, type Lang } from '@guanacaste/shared/contact';
import { copy, site } from '../content';

interface Props { lang: Lang; title: string; description: string; altPath: string; jsonLd?: object[] }
const { lang, title, description, altPath, jsonLd } = Astro.props;
const t = copy[lang];
---
<BaseLayout {title} {description} {lang} {altPath} siteName={site} themeColor="#0E1A24" {jsonLd}>
  <header class="bar">
    <a class="mark" href={paths[lang].home} aria-label={`${site}, home`}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".45"/><path d="M12 12V2a10 10 0 0 1 8.7 5Z" fill="#3BB273"/><circle cx="12" cy="12" r="1.8" fill="currentColor"/></svg>
      <span>Guanacaste <b>Roofing</b></span>
    </a>
    <a class="lang" href={altPath} hreflang={t.langSwitch.hreflang} lang={t.langSwitch.hreflang}>{t.langSwitch.label}</a>
  </header>
  <slot />
  <footer class="foot">
    <p class="foot-name">{site}</p>
    <p>{t.footerNote}</p>
    <p><a href={paths[lang].privacy}>{t.privacy}</a> · <a href={altPath} hreflang={t.langSwitch.hreflang} lang={t.langSwitch.hreflang}>{t.langSwitch.label}</a></p>
  </footer>
</BaseLayout>
